# ==============================================================================
# Commet Web Client - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Port Configuration
# ------------------------------------------------------------------------------
# Host port to expose the Commet Web container directly (e.g. 28080, 8080)
# If using with an existing reverse proxy (Traefik, Nginx Proxy Manager, Cloudflare),
# point your proxy to http://<vps-ip>:${COMMET_PORT}
COMMET_PORT=28080
PORT=28080

# Host ports for the built-in Caddy reverse proxy (used with: docker compose --profile https up -d)
# HTTP port (for redirect & ACME Let's Encrypt challenge verification)
HTTP_PORT=280

# HTTPS port (for encrypted SSL/TLS traffic)
HTTPS_PORT=2443

# ------------------------------------------------------------------------------
# Matrix Application Configuration
# ------------------------------------------------------------------------------
# The default Matrix Homeserver shown in the login screen.
# Defaults to matrix.org, or change to your own server (e.g. matrix.yourdomain.com)
DEFAULT_HOMESERVER=matrix.org

# Optional: Calendar widget host
CALENDAR_WIDGET=calendar-widget.commet.chat

# ------------------------------------------------------------------------------
# Built-in Automatic HTTPS (Caddy) Settings
# Only required if you run: docker compose --profile https up -d
# ------------------------------------------------------------------------------
# Set your fully qualified domain name (DNS A/AAAA record pointing to your VPS)
DOMAIN=chat.yourdomain.com

# Email address for Let's Encrypt TLS certificate notifications
ACME_EMAIL=admin@yourdomain.com
